<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_panel_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/albRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/albRowMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nf_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAlbToggle"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/bg_btn_secondary"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Shown"
        android:textAllCaps="false"
        android:textColor="@color/nf_text_primary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnAlbSelectItems"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_secondary"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Pick Items"
        android:textAllCaps="false"
        android:textColor="@color/nf_text_primary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnAlbType"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_secondary"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Auto"
        android:textAllCaps="false"
        android:textColor="@color/nf_text_primary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnAlbDelete"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_secondary"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Remove"
        android:textAllCaps="false"
        android:textColor="#FF8A80"
        android:textSize="12sp" />
</LinearLayout>
