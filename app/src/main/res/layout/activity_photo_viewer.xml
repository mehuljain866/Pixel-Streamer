<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/photoFullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <Button
        android:id="@+id/btnPhotoBack"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill_glass"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="←  Back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/photoOverlayBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_gradient_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingTop="32dp"
        android:paddingEnd="36dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/photoCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/photoCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/nf_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPhotoPrev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_glass"
            android:focusable="true"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPhotoNext"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill_glass"
            android:focusable="true"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPhotoSlideshow"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_primary"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="▶  Slideshow"
            android:textAllCaps="false"
            android:textColor="@color/nf_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
