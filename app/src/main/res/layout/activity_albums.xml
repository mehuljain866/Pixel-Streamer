<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nf_bg"
    android:orientation="vertical"
    android:paddingStart="38dp"
    android:paddingTop="22dp"
    android:paddingEnd="38dp"
    android:paddingBottom="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixel_bold"
            android:text="PIXEL STREAMER"
            android:textColor="@color/ps_accent"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Albums, Selection &amp; Phone Setup"
            android:textColor="@color/nf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAlbumsDone"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_secondary"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="←  Back to Home"
            android:textAllCaps="false"
            android:textColor="@color/nf_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Pane: QR Companion & Actions (Scrollable for Tablet screens) -->
        <ScrollView
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel_card"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <Button
                    android:id="@+id/btnAddAlbumDirect"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_primary"
                    android:focusable="true"
                    android:text="+ Add Shared Album Link"
                    android:textAllCaps="false"
                    android:textColor="@color/nf_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSyncAll"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:focusable="true"
                    android:text="↻  Sync All Enabled Albums"
                    android:textAllCaps="false"
                    android:textColor="@color/nf_text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTmdbSettings"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:focusable="true"
                    android:text="⚙  TMDB Key &amp; Quality"
                    android:textAllCaps="false"
                    android:textColor="@color/nf_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Or Scan with Phone Camera"
                    android:textColor="@color/nf_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/albumsQrImage"
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Companion Web UI QR Code"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/albumsServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Connect Wi-Fi to paste links from phone"
                    android:textColor="@color/nf_badge_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- Right Pane: Saved Albums List -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/albumsListHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="Shared Albums (Toggle which albums &amp; items appear on Home)"
                android:textColor="@color/nf_text_secondary"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/albumsRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
