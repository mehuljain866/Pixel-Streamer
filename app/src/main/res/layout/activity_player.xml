<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- Minimal transparent spinner on initial stream start -->
    <ProgressBar
        android:id="@+id/loadingOverlay"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/ps_accent"
        android:visibility="gone" />

    <!-- PAUSE INFO OVERLAY (Only visible when PAUSED — Image 1 style with Movie Logo PNG!) -->
    <FrameLayout
        android:id="@+id/pauseInfoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pause_left_scrim" />

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="52dp"
            android:paddingEnd="24dp"
            android:paddingBottom="70dp">

            <!-- Official Movie/Show Transparent Title Logo (Interstellar-style typography!) -->
            <ImageView
                android:id="@+id/pauseTitleLogo"
                android:layout_width="340dp"
                android:layout_height="84dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <!-- Crisp Fallback Title when no PNG logo is available -->
            <TextView
                android:id="@+id/pauseMovieTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/pixel_bold"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pauseMovieMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D0D0D8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pauseContentRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_outline"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="#E0E0E8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/pauseMovieOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="3"
                android:textColor="#C2C2CC"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- BOTTOM TIMELINE & ICON CONTROLS (Shown on Up/Down key WITHOUT pausing, and when paused!) -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_gradient_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hudBarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/hudBufferSpinner"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:indeterminateTint="@color/ps_accent"
                    android:visibility="gone" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/pauseSeekBar"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:focusable="true"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:progressDrawable="@drawable/bg_seekbar_player_track"
                android:splitTrack="false"
                android:thumb="@drawable/thumb_seekbar_netflix"
                android:thumbOffset="11dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPauseResume"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Play or Pause"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/btnPauseRew10"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Rewind 10 seconds"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_replay_10" />

                <ImageButton
                    android:id="@+id/btnPauseFwd10"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Forward 10 seconds"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_forward_10" />

                <TextView
                    android:id="@+id/pauseTimeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="00:00 / 00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnPauseNext"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Next Episode or Video"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next" />

                <ImageButton
                    android:id="@+id/btnPauseSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Player Settings"
                    android:focusable="true"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />

                <ImageButton
                    android:id="@+id/btnPauseBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="Exit Player"
                    android:focusable="true"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- FLOATING PLAYER SETTINGS SUB-MENU (Opens when pressing ⚙ icon!) -->
    <FrameLayout
        android:id="@+id/settingsPopupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsPopupCard"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="78dp"
            android:background="@drawable/bg_popup_card"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixel_bold"
                android:text="STREAM SETTINGS"
                android:textColor="@color/ps_accent"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Video Quality"
                android:textColor="#9E9EAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/qualityOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Playback Speed"
                android:textColor="#9E9EAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/speedOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aspect / Fit"
                android:textColor="#9E9EAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/aspectOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
